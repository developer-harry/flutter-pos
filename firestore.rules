rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function activeProduct(productId) {
      let productPath = /databases/$(database)/documents/products/$(productId);
      return exists(productPath) && get(productPath).data.active == true;
    }

    function validCheckoutOrder() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId',
          'userName',
          'items',
          'productIds',
          'quantities',
          'prices',
          'total',
          'paymentMethod',
          'status',
          'createdAt',
          'paymentSettled',
          'settlementUpdatedAt',
          'settlementUpdatedBy'
        ])
        && data.keys().hasOnly([
          'userId',
          'userName',
          'items',
          'productIds',
          'quantities',
          'prices',
          'total',
          'paymentMethod',
          'status',
          'createdAt',
          'salesCounted',
          'paymentSettled',
          'settlementUpdatedAt',
          'settlementUpdatedBy'
        ])
        && (!data.keys().hasAny(['salesCounted']) || data.salesCounted == true)
        && data.paymentSettled == true
        && data.settlementUpdatedAt == request.time
        && data.settlementUpdatedBy == request.auth.uid
        && data.userId == request.auth.uid
        && data.userName is string
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 40
        && data.productIds is list
        && data.productIds.size() == data.items.size()
        && data.productIds.size() <= 40
        && data.quantities is map
        && data.prices is map
        && data.quantities.keys().hasOnly(data.productIds)
        && data.productIds.hasOnly(data.quantities.keys())
        && data.prices.keys().hasOnly(data.productIds)
        && data.productIds.hasOnly(data.prices.keys())
        && data.total is int
        && data.total >= 0
        && data.paymentMethod in ['現金', 'カード']
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function validStockDecrement(productId) {
      let orderId = request.resource.data.lastSaleOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let order = getAfter(orderPath).data;
      let salesCounted = order.get('salesCounted', false) == true;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'soldCount', 'lastSaleOrderId', 'updatedAt'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.lastSaleOrderId is string
        && !exists(orderPath)
        && existsAfter(orderPath)
        && order.userId == request.auth.uid
        && order.status == 'pending'
        && order.productIds.hasAny([productId])
        && order.quantities[productId] is int
        && order.quantities[productId] > 0
        && order.prices[productId] == resource.data.price
        && resource.data.stock - request.resource.data.stock
          == order.quantities[productId]
        && (salesCounted
          ? request.resource.data.soldCount is int
            && request.resource.data.soldCount >= 0
            && request.resource.data.soldCount
              == resource.data.get('soldCount', 0) + order.quantities[productId]
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['soldCount']));
    }

    function validOrderCancellation() {
      let data = request.resource.data;
      return signedIn()
        && ((resource.data.status == 'pending'
            && (isAdmin() || resource.data.userId == request.auth.uid))
          || (resource.data.status == 'completed' && isAdmin()))
        && data.status == 'cancelled'
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'cancelledAt',
          'cancelledBy',
          'cancelledByName'
        ])
        && data.cancelledAt == request.time
        && data.cancelledBy == request.auth.uid
        && data.cancelledByName is string
        && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    function validOrderSalesMarking() {
      let data = request.resource.data;
      return isAdmin()
        && resource.data.status in [
          'pending',
          'preparing',
          'shipped',
          'completed'
        ]
        && resource.data.get('salesCounted', false) != true
        && data.salesCounted == true
        && data.diff(resource.data).affectedKeys().hasOnly(['salesCounted']);
    }

    function validOrderSettlement() {
      let data = request.resource.data;
      return isAdmin()
        && resource.data.status in ['preparing', 'shipped', 'completed']
        && data.status == resource.data.status
        && data.paymentSettled is bool
        && data.paymentSettled != resource.data.get('paymentSettled', true)
        && data.settlementUpdatedAt == request.time
        && data.settlementUpdatedBy == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly([
          'paymentSettled',
          'settlementUpdatedAt',
          'settlementUpdatedBy'
        ]);
    }

    function validAdminOrderProgress() {
      let data = request.resource.data;
      let accepting = resource.data.status == 'pending'
        && data.status == 'preparing'
        && data.acceptedAt == request.time
        && data.acceptedBy == request.auth.uid
        && data.acceptedByName is string
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'acceptedAt',
          'acceptedBy',
          'acceptedByName'
        ]);
      let shipping = resource.data.status == 'preparing'
        && data.status == 'shipped'
        && data.shippedAt == request.time
        && data.shippedBy == request.auth.uid
        && data.shippedByName is string
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'shippedAt',
          'shippedBy',
          'shippedByName'
        ]);
      return isAdmin() && (accepting || shipping);
    }

    function validOrderRejection() {
      let data = request.resource.data;
      return isAdmin()
        && resource.data.status == 'pending'
        && data.status == 'rejected'
        && data.rejectedAt == request.time
        && data.rejectedBy == request.auth.uid
        && data.rejectedByName is string
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'rejectedAt',
          'rejectedBy',
          'rejectedByName'
        ]);
    }

    function validStockReturnForRejection(productId) {
      let orderId = request.resource.data.lastRejectionOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let originalOrder = get(orderPath).data;
      let rejectedOrder = getAfter(orderPath).data;
      let currentSoldCount = resource.data.get('soldCount', 0);
      let returnedSoldCount = currentSoldCount < rejectedOrder.quantities[productId]
        ? currentSoldCount
        : rejectedOrder.quantities[productId];
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'soldCount', 'lastRejectionOrderId', 'updatedAt'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.lastRejectionOrderId is string
        && exists(orderPath)
        && existsAfter(orderPath)
        && originalOrder.status == 'pending'
        && rejectedOrder.status == 'rejected'
        && rejectedOrder.rejectedBy == request.auth.uid
        && rejectedOrder.productIds.hasAny([productId])
        && rejectedOrder.quantities[productId] is int
        && rejectedOrder.quantities[productId] > 0
        && request.resource.data.stock - resource.data.stock
          == rejectedOrder.quantities[productId]
        && (rejectedOrder.get('salesCounted', false) == true
          ? request.resource.data.soldCount is int
            && request.resource.data.soldCount >= 0
            && currentSoldCount is int
            && request.resource.data.soldCount
              == currentSoldCount - returnedSoldCount
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['soldCount']));
    }

    function validStockRestore(productId) {
      let orderId = request.resource.data.lastCancellationOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let previousOrder = get(orderPath).data;
      let cancelledOrder = getAfter(orderPath).data;
      let currentSoldCount = resource.data.get('soldCount', 0);
      let salesCounted = cancelledOrder.get('salesCounted', false) == true;
      let returnedSoldCount = salesCounted
        ? currentSoldCount < cancelledOrder.quantities[productId]
          ? currentSoldCount
          : cancelledOrder.quantities[productId]
        : 0;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'stock',
            'soldCount',
            'lastCancellationOrderId',
            'updatedAt'
          ])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.lastCancellationOrderId is string
        && exists(orderPath)
        && existsAfter(orderPath)
        && ((previousOrder.status == 'pending'
            && (isAdmin() || previousOrder.userId == request.auth.uid))
          || (previousOrder.status == 'completed' && isAdmin()))
        && cancelledOrder.status == 'cancelled'
        && cancelledOrder.cancelledBy == request.auth.uid
        && (isAdmin() || previousOrder.userId == request.auth.uid)
        && cancelledOrder.productIds.hasAny([productId])
        && cancelledOrder.quantities[productId] is int
        && cancelledOrder.quantities[productId] > 0
        && request.resource.data.stock - resource.data.stock
          == cancelledOrder.quantities[productId]
        && (salesCounted
          ? request.resource.data.soldCount is int
            && request.resource.data.soldCount >= 0
            && currentSoldCount is int
            && request.resource.data.soldCount
              == currentSoldCount - returnedSoldCount
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['soldCount']));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'createdAt'
        ]);
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && resource.data.role == 'user'
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'phone', 'address', 'favorites'])
          && (!request.resource.data.keys().hasAny(['phone'])
            || (request.resource.data.phone is string
              && request.resource.data.phone.size() <= 30))
          && (!request.resource.data.keys().hasAny(['address'])
            || (request.resource.data.address is string
              && request.resource.data.address.size() <= 200))
          && (!request.resource.data.keys().hasAny(['favorites'])
            || (request.resource.data.favorites is list
              && request.resource.data.favorites.size() <= 200)));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn() || activeProduct(productId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && (validStockDecrement(productId)
            || validStockRestore(productId)
            || validStockReturnForRejection(productId)));

      match /comments/{commentId} {
        allow read: if signedIn() || activeProduct(productId);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/products/$(productId))
          && request.resource.data.keys().hasAll([
            'uid',
            'authorName',
            'text',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid',
            'authorName',
            'text',
            'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && validCheckoutOrder();
      allow update: if validOrderCancellation()
        || validOrderSalesMarking()
        || validOrderSettlement()
        || validAdminOrderProgress()
        || validOrderRejection();
      allow delete: if false;
    }
  }
}
